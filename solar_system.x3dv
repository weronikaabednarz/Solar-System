# Obrot wokol osi slonca
DEF ObrotSlonca OrientationInterpolator{
	key [0, 0.25, 0.5, 0.75, 1]
	keyValue [0 1 0 0,0 1 0 -1.57,0 1 0 -3.14,0 1 0 -4.71,0 1 0 -6.28]
}
DEF CzasSlonca TimeSensor{
	loop TRUE
	cycleInterval 10
}
ROUTE CzasSlonca.fraction_changed TO ObrotSlonca.set_fraction
ROUTE ObrotSlonca.value_changed TO Slonce.set_rotation

DEF ObrotMerkury OrientationInterpolator {
    key [0, 0.25, 0.5, 0.75, 1]
    keyValue [0 1 0 0, 0 1 0 1.57, 0 1 0 3.14, 0 1 0 4.71, 0 1 0 6.28]
}
