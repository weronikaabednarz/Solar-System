#X3D V3.3 utf8


Viewpoint {
    position 0 0 400  
    description "Widok z przodu"
}

Viewpoint {
    position 0 400 0  
    orientation 1 0 0 -1.57 
    description "Widok z góry"
}

Viewpoint {
    position 0 0 0 
    description "Widok ze Słońca"
}

PointLight { 
    color 1 1 0
    intensity 1
    location 0 20 0
    on TRUE 
    radius 100
}

DEF Slonce Transform{
    children[
        Transform{
            translation 0 0 0
            children[
                Shape{
                    appearance Appearance{
                        texture ImageTexture{
                            url "sun.jpg"
                        }
                        material Material{
                            diffuseColor 1 1 0
                        }
                    }
                    geometry Sphere{
                        radius 20
                    }
                }
            ]
        }
    ]
}

DEF Merkury Transform{
    translation 35 0 0
	center -35 0 0
    children[
        DEF Merkury2 Transform{
            children[
                Shape{
                    appearance Appearance{
                        texture ImageTexture{
                            url "2k_mercury.jpg"
                        }
                        material Material{
                            diffuseColor 0.5 0.5 0.5
                        }
                    }
                    geometry Sphere{
                        radius 0.5
                    }
                }
            ]
        }
    ]
}

